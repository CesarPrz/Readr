// Règles Firestore — Phase 2 (sauvegarde perso) + "Listes de lecture
// publiques" + "Recommandations collaboratives" + "Profil fusionné" (voir le
// plan Firebase, doc Claude du projet). Depuis l'ajout des Cloud Functions
// (voir `functions/`), ce fichier EST déployable via la Firebase CLI
// (`firebase deploy --only firestore:rules`, voir `firebase.json`) — avant
// ça, le projet n'avait pas de CLI du tout et ce fichier servait seulement de
// référence à coller manuellement dans Firebase Console. Les deux méthodes
// marchent : coller manuellement reste possible, mais le déploiement CLI est
// désormais la marche à suivre recommandée, dans CHACUN des deux projets
// (dev et prod — voir README, section "Environnements", pour `firebase use
// <alias>`).
//
// Décision produit ("Listes de lecture publiques") : les listes de lecture
// et les livres qu'elles contiennent sont en LECTURE PUBLIQUE — n'importe
// quel utilisateur connecté (même anonyme) peut voir la bibliothèque et les
// listes de n'importe qui. L'écriture reste réservée au propriétaire.
// Parcourir les listes d'un AUTRE utilisateur n'est pas encore construit
// côté UI (Phase 4, "Amis"/découverte, pas encore conçue) — ces règles
// ouvrent seulement la donnée, sans écran de navigation associé pour
// l'instant.
rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // "Profil fusionné" (07/10/2026) : pseudo public (`username`, modifiable
    // à tout moment même resté anonyme) + miroir de la photo Google
    // (`photoUrl`), voir `UserProfileRepository`. Étendu par "Profil façon
    // Instagram" (08/10/2026) avec une description libre (`bio`) — même
    // document, mêmes règles, rien à changer ici pour ce champ en plus. Même
    // logique de lecture publique/écriture propriétaire que `library`/
    // `lists` ci-dessous — posé en prévision de la Phase "Amis" (consultation
    // du profil d'un AUTRE utilisateur), pas encore d'écran qui lit le profil
    // de quelqu'un d'autre pour l'instant. Les compteurs Abonnés/Abonnements
    // affichés par `ProfileHeader` ne vivent dans AUCUN document Firestore :
    // purement visuels pour l'instant (toujours 0), voir la doc de ce
    // composant.
    match /users/{uid} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == uid;
    }
    match /users/{uid}/library/{bookId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == uid;
    }
    match /users/{uid}/lists/{listId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == uid;
    }
    // "Recommandations collaboratives" (voir le plan Firebase, doc Claude du
    // projet) : statistiques pré-calculées par la Cloud Function planifiée
    // `scheduledRecomputeBookStats` (voir `functions/src/recomputeBookStats.ts`).
    // Lecture publique comme le reste (même logique que `library`/`lists`) ;
    // écriture refusée à TOUT LE MONDE côté client — seul le SDK Admin d'une
    // Cloud Function peut y écrire, et le SDK Admin ignore ces règles de
    // toute façon (il n'en a pas besoin), donc `allow write: if false`
    // n'empêche en rien la Cloud Function de fonctionner, seulement un
    // client malveillant d'écrire de fausses statistiques.
    match /bookStats/{bookId} {
      allow read: if request.auth != null;
      allow write: if false;
    }
  }
}
