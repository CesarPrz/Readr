{
  "expo": {
    "name": "Readr",
    "slug": "readr",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#1B1023"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.cesarprz.readr",
      "googleServicesFile": "./GoogleService-Info.plist"
    },
    "android": {
      "package": "com.cesarprz.readr",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#1B1023"
      },
      "googleServicesFile": "./google-services.json"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      [
        "expo-camera",
        {
          "cameraPermission": "Autorise Readr à utiliser l'appareil photo pour scanner le code-barres d'un livre."
        }
      ],
      "@react-native-google-signin/google-signin"
    ]
  }
}
