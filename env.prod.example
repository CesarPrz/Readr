# Environnement PROD — copie ce fichier en `.env.prod` (jamais commité, voir
# .gitignore) et remplis tes valeurs. Puis : `npm run env:prod` pour l'activer
# (copie ce fichier vers `.env`, le seul que Expo charge réellement).
#
# Sert à ton usage réel de l'app (données à garder, pas de test dessus).
# Nécessite un DEUXIÈME projet Firebase, distinct de celui utilisé pour le
# dev — voir le README, section "Environnements (dev / prod)", pour les
# étapes de création (Claude ne peut pas créer de projet Firebase à ta place,
# ça nécessite ton propre compte Google).
EXPO_PUBLIC_APP_ENV=production

# Peut être la même clé que dans `.env.dev` — la quota Google Books n'a pas
# besoin d'être séparée par environnement. Voir env.dev.example pour la
# marche à suivre si tu n'en as pas encore.
EXPO_PUBLIC_GOOGLE_BOOKS_API_KEY=

# Config Firebase de TON PROJET PROD (distinct du projet dev) — même marche à
# suivre que pour le dev (voir env.dev.example) : Firebase Console → ce
# nouveau projet → Paramètres du projet → Général → "Vos applications" →
# application Web (icône </>), puis Authentication → Sign-in method →
# Anonymous → activer.
EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=
EXPO_PUBLIC_FIREBASE_PROJECT_ID=
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
EXPO_PUBLIC_FIREBASE_APP_ID=
